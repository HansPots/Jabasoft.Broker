<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Jabasoft.Broker</RootNamespace>
    <Version>0.1.0.30</Version>
    <!-- Niet-deterministisch: elke build geeft een ander bestand. Smart App
         Control onthoudt zijn oordeel per bestand (hash); is Ã©Ã©n build ooit
         geblokkeerd, dan zou een deterministische herbouw van dezelfde code
         precies dat geblokkeerde bestand opnieuw opleveren. -->
    <Deterministic>false</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <!-- Tray\ is een eigen project (het pictogram in het systeemvak), geen onderdeel van de broker. -->
    <Compile Remove="Tray\**" />
    <Content Remove="Tray\**" />
    <None Remove="Tray\**" />
    <EmbeddedResource Remove="Tray\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Jabasoft.Base\Jabasoft.Base.csproj" />

    <!-- De AI-database (JabasoftAi): de zoekindex voor semantisch zoeken.
         Wel via Entity Framework, in tegenstelling tot TokenUsageEntries
         hierboven - dit is een tabel die WIJ modelleren en die kan blijven
         evolueren (zie Jabasoft.Ai.Data.Entities.SearchDocument), dus
         migraties zijn hier de goede investering. -->
    <ProjectReference Include="..\Jabasoft.Base\Jabasoft.Ai.Data\Jabasoft.Ai.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Het tokenverbruik gaat naar de gedeelde tabel TokenUsageEntries in
         JabasoftBase. Rechtstreeks met SqlClient en niet via Entity
         Framework: het zijn een INSERT en twee SELECTs op een tabel die al
         bestaat, dus er valt niets te migreren of te modelleren. -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <!-- SqlClient trekt System.Security.Cryptography.Pkcs 9.0.18 mee, met bekende
         lekken (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7). Hier een veilige versie vastgezet. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.15" />

    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.13" />

    <!-- MCP (Model Context Protocol): het endpoint /mcp waarmee Claude Code
         en Hermes de broker als gereedschap kunnen gebruiken - zie
         McpTools.cs. -->
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.4.0" />

    <!-- Om Hermes' config.yaml te lezen en alleen de sleutels van Jabasoft
         te wijzigen - zie HermesConfigStore.cs. -->
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

</Project>
